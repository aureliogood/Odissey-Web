# ============================================================
#  Configuración del sincronizador de tops (BK-Tops -> Supabase)
#  Copia este archivo como .env y rellena los valores.
#  NO subas .env a GitHub: contiene la service role key.
# ============================================================

# --- MySQL de BK-Tops ---------------------------------------
# En plugins/BK-Tops/configuration/database.yml pon driver: mysql
# y usa los mismos datos de conexión.
BKTOPS_DB_HOST=127.0.0.1
BKTOPS_DB_PORT=3306
BKTOPS_DB_USER=tu_usuario_mysql
BKTOPS_DB_PASSWORD=tu_contraseña_mysql
BKTOPS_DB_NAME=bktops

# --- Supabase -----------------------------------------------
# Project URL (la raíz, sin /rest/v1).
SUPABASE_URL=https://cffpnxmtwfaublkvrobt.supabase.co
# Service role key: Supabase > Project Settings > API > service_role.
# Es SECRETA. Solo va aquí, en el servidor. Nunca en el JS de la web.
SUPABASE_SERVICE_ROLE_KEY=pega_aqui_la_service_role_key

# --- Tops ---------------------------------------------------
# IDs de tops.yml separados por comas.
TOPS=kills,money,time_played

# Cuántas posiciones se guardan y muestran (1-100).
TOPS_LIMIT=10

# Pon true para probar sin escribir en Supabase.
DRY_RUN=false
